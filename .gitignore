# Secrets. Nothing that starts with .env is committed, except the example.
.env*
!.env.example

# Local tool state
.claude/settings.local.json
.claude/worktrees/
.vercel/

# Dependencies and build output
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# Local uploads (preview and production keep theirs in Vercel Blob)
/media/

# Test output
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# System and debug files
.DS_Store
*.pem
npm-debug.log*
