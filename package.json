{
  "name": "dimm-os",
  "private": true,
  "description": "A portfolio built as an operating system: every page is a window.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload build",
    "ci": "cross-env NODE_OPTIONS=--no-deprecation DATABASE_URL=$DATABASE_URL_UNPOOLED payload migrate && pnpm build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint . && stylelint \"src/**/*.css\"",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "prepare": "husky",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:unit && pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts --project int",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts --project unit",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "4.0.0-beta.9",
    "@payloadcms/next": "4.0.0-beta.9",
    "@payloadcms/plugin-mcp": "4.0.0-beta.9",
    "@payloadcms/richtext-lexical": "4.0.0-beta.9",
    "@payloadcms/transformer-sharp": "4.0.0-beta.9",
    "@payloadcms/ui": "4.0.0-beta.9",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "motion": "14.14.0",
    "next": "16.4.2",
    "payload": "4.0.0-beta.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.2",
    "husky": "9.1.7",
    "jsdom": "28.0.0",
    "oxfmt": "^0.73.0",
    "stylelint": "18.0.0",
    "stylelint-declaration-strict-value": "1.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "5.0.1"
  },
  "browserslist": [
    "chrome >= 123",
    "firefox >= 120",
    "safari >= 17.5"
  ],
  "engines": {
    "node": "24.x",
    "pnpm": "^9 || ^10 || ^11",
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.28.9"
}
